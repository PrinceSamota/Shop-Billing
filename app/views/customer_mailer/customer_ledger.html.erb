<div style="margin: 0; padding: 24px 10px; background-color: #f3f4f6; font-family: Arial, Helvetica, sans-serif; color: #1f2937;">
  <div style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden;">

    <!-- Shop Header -->
    <div style="background-color: #ffffff; padding: 24px 20px; text-align: center; border-bottom: 3px solid #16a34a;">
      <h1 style="margin: 0; font-size: 26px; color: #166534; letter-spacing: 1px;">
        BALAJI TRADERS
      </h1>
      <p style="margin: 8px 0 0; font-size: 13px; color: #6b7280;">
        Village - Lampuwa
      </p>
      <p style="margin: 5px 0 0; font-size: 12px; color: #6b7280;">
        Customer Account Statement
      </p>
    </div>

    <!-- Message -->
    <div style="padding: 24px 20px 12px;">
      <h2 style="margin: 0 0 14px; font-size: 20px; color: #111827;">
        Namaste <%= @customer.name.to_s.titleize %> ji!
      </h2>

      <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #4b5563;">
        Aapke khate ka vartaman hisaab neeche diya gaya hai.
        Kripya details check kar lein.
      </p>
    </div>

    <!-- Account Summary -->
    <div style="padding: 12px 20px 24px;">
      <table width="100%" cellpadding="0" cellspacing="0"
             style="border-collapse: collapse; font-size: 14px;">

        <tr style="background-color: #f9fafb;">
          <th align="left" style="padding: 13px 12px; border: 1px solid #e5e7eb; color: #374151;">
            Details
          </th>
          <th align="right" style="padding: 13px 12px; border: 1px solid #e5e7eb; color: #374151;">
            Amount
          </th>
        </tr>

        <tr>
          <td style="padding: 14px 12px; border: 1px solid #e5e7eb;">
            Total Bills (Udhaar)
          </td>
          <td align="right" style="padding: 14px 12px; border: 1px solid #e5e7eb; white-space: nowrap;">
            ₹<%= number_with_precision(@total_udhaar, precision: 2) %>
          </td>
        </tr>

        <tr>
          <td style="padding: 14px 12px; border: 1px solid #e5e7eb;">
            Total Jama
          </td>
          <td align="right" style="padding: 14px 12px; border: 1px solid #e5e7eb; white-space: nowrap; color: #15803d; font-weight: bold;">
            ₹<%= number_with_precision(@total_jama, precision: 2) %>
          </td>
        </tr>

        <tr style="background-color: #f0fdf4;">
          <td style="padding: 16px 12px; border: 1px solid #bbf7d0; font-weight: bold; color: #166534;">
            Current Balance
          </td>
          <td align="right" style="padding: 16px 12px; border: 1px solid #bbf7d0; font-size: 18px; font-weight: bold; color: #166534; white-space: nowrap;">
            ₹<%= number_with_precision(@current_balance, precision: 2) %>
          </td>
        </tr>

      </table>

      <p style="margin: 20px 0 0; font-size: 13px; line-height: 1.7; color: #4b5563;">
        Agar aapne haal hi mein koi payment jama karayi hai aur woh is hisaab mein nahi dikh rahi, toh kripya dukaan par sampark karein.
      </p>
    </div>

    <!-- Footer -->
    <div style="padding: 18px 20px; text-align: center; background-color: #f9fafb; border-top: 1px solid #e5e7eb;">
      <p style="margin: 0; font-size: 14px; font-weight: bold; color: #166534;">
        Dhanyavaad!
      </p>
      <p style="margin: 5px 0 0; font-size: 12px; color: #6b7280;">
        BALAJI TRADERS · Lampuwa
      </p>
      <p style="margin: 10px 0 0; font-size: 11px; color: #9ca3af;">
        Yeh aapke khate ka automatic statement email hai.
      </p>
    </div>

  </div>
</div>
