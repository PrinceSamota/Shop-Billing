<div class="min-h-screen bg-gray-50 p-4 sm:p-6">
  <div class="mx-auto max-w-7xl space-y-6">

    <!-- Header -->
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
      <div class="flex items-start gap-3">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-blue-100 text-xl font-bold text-blue-700">
          <%= @library_student.name.to_s.first&.upcase || "S" %>
        </div>

        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
              <%= @library_student.name.to_s.titleize %>
            </h1>

            <% if @library_student.left? %>
              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">Left</span>
            <% elsif @library_student.fee_warning.present? %>
              <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
                <%= @library_student.fee_warning %>
              </span>
            <% else %>
              <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800">Active</span>
            <% end %>
          </div>

          <p class="mt-1 text-sm text-gray-500">
            Library student details aur payment history
          </p>

          <p class="mt-1 text-sm text-gray-500">
            <%= @library_student.phone.presence || "Mobile number not added" %>
          </p>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <%= link_to library_students_path,
            class: "inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-4 py-2.5 font-semibold text-gray-700 transition hover:bg-gray-50" do %>
          ← Back
        <% end %>

        <%= link_to edit_library_student_path(@library_student),
            class: "inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-4 py-2.5 font-semibold text-gray-700 transition hover:bg-gray-50" do %>
          ✎ Edit Student
        <% end %>

        <% if @library_student.active? %>
          <%= link_to new_library_student_library_payment_path(@library_student),
              class: "inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 font-semibold text-white shadow-sm transition hover:bg-blue-700" do %>
            <span class="text-lg">＋</span>
            Collect Fee
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

      <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-gray-500">Monthly Fee</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-xl">₹</span>
        </div>

        <p class="mt-3 text-3xl font-bold text-gray-900">
          ₹<%= number_with_precision(@library_student.monthly_fee, precision: 2, strip_insignificant_zeros: true) %>
        </p>

        <p class="mt-1 text-xs text-gray-500">Regular monthly charges</p>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-gray-500">Total Fee Received</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-green-50 text-xl">✓</span>
        </div>

        <p class="mt-3 text-3xl font-bold text-green-700">
          ₹<%= number_with_precision(@library_student.total_paid, precision: 2, strip_insignificant_zeros: true) %>
        </p>

        <p class="mt-1 text-xs text-gray-500">Total payments recorded</p>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-gray-500">Fee Valid Till</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl">📅</span>
        </div>

        <p class="mt-3 text-2xl font-bold text-gray-900">
          <%= @library_student.fee_valid_till&.strftime("%d %b %Y") || "Payment pending" %>
        </p>

        <% if @library_student.fee_warning.present? %>
          <p class="mt-2 text-sm font-medium text-amber-700">
            <%= @library_student.fee_warning %>
          </p>
        <% else %>
          <p class="mt-1 text-xs text-gray-500">Fee validity information</p>
        <% end %>
      </div>

    </div>

    <!-- Admission Details -->
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
      <div class="flex items-center gap-3 border-b border-gray-100 px-5 py-4 sm:px-6">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-xl">👤</span>
        <div>
          <h2 class="text-lg font-bold text-gray-900">Admission Details</h2>
          <p class="text-sm text-gray-500">Student ki personal aur library information</p>
        </div>
      </div>

      <div class="grid gap-0 sm:grid-cols-2 lg:grid-cols-3">

        <div class="border-b border-gray-100 p-5 sm:border-r">
          <p class="text-sm text-gray-500">Student Name</p>
          <p class="mt-1 font-semibold text-gray-900"><%= @library_student.name.to_s.titleize %></p>
        </div>

        <div class="border-b border-gray-100 p-5 lg:border-r">
          <p class="text-sm text-gray-500">Mobile Number</p>
          <p class="mt-1 font-semibold text-gray-900">
            <%= @library_student.phone.presence || "Not added" %>
          </p>
        </div>

        <div class="border-b border-gray-100 p-5 sm:border-r lg:border-r-0">
          <p class="text-sm text-gray-500">Admission Date</p>
          <p class="mt-1 font-semibold text-gray-900">
            <%= @library_student.admission_date&.strftime("%d %b %Y") || "—" %>
          </p>
        </div>

        <div class="border-b border-gray-100 p-5 lg:border-b-0 lg:border-r">
          <p class="text-sm text-gray-500">Student Status</p>
          <div class="mt-2">
            <% if @library_student.left? %>
              <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-semibold text-gray-700">Left</span>
            <% else %>
              <span class="rounded-full bg-green-100 px-3 py-1.5 text-xs font-semibold text-green-800">Active</span>
            <% end %>
          </div>
        </div>

        <div class="border-b border-gray-100 p-5 sm:border-b-0 sm:border-r">
          <p class="text-sm text-gray-500">Left Date</p>
          <p class="mt-1 font-semibold text-gray-900">
            <%= @library_student.left_date&.strftime("%d %b %Y") || "—" %>
          </p>
        </div>

        <div class="p-5">
          <p class="text-sm text-gray-500">Monthly Fee</p>
          <p class="mt-1 font-semibold text-gray-900">
            ₹<%= number_with_precision(@library_student.monthly_fee, precision: 2, strip_insignificant_zeros: true) %>
          </p>
        </div>

      </div>

      <% if @library_student.notes.present? %>
        <div class="border-t border-gray-100 bg-gray-50/70 p-5 sm:px-6">
          <p class="text-sm font-semibold text-gray-700">Notes</p>
          <p class="mt-2 whitespace-pre-line text-sm leading-6 text-gray-600"><%= @library_student.notes %></p>
        </div>
      <% end %>

      <!-- Student Status Actions -->
      <div class="flex flex-wrap gap-3 border-t border-gray-100 bg-gray-50/50 p-5 sm:px-6">
        <% if @library_student.active? %>
          <%= button_to "Mark as Left",
              mark_left_library_student_path(@library_student),
              method: :patch,
              class: "rounded-xl border border-red-200 bg-white px-4 py-2.5 font-semibold text-red-700 transition hover:bg-red-50",
              form: { data: { turbo_confirm: "Kya is student ko library se Left mark karna hai?" } } %>
        <% else %>
          <%= button_to "Mark as Active",
              mark_active_library_student_path(@library_student),
              method: :patch,
              class: "rounded-xl border border-green-200 bg-white px-4 py-2.5 font-semibold text-green-700 transition hover:bg-green-50" %>
        <% end %>
      </div>
    </section>

    <!-- Payment History -->
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

      <div class="flex flex-col justify-between gap-3 border-b border-gray-100 px-5 py-4 sm:flex-row sm:items-center sm:px-6">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-green-50 text-xl">💳</span>
          <div>
            <h2 class="text-lg font-bold text-gray-900">Payment History</h2>
            <p class="text-sm text-gray-500">Student ki saari recorded fee payments</p>
          </div>
        </div>

        <div class="rounded-xl bg-green-50 px-4 py-2">
          <p class="text-xs font-medium text-green-700">Total Received</p>
          <p class="text-lg font-bold text-green-800">
            ₹<%= number_with_precision(@library_student.total_paid, precision: 2, strip_insignificant_zeros: true) %>
          </p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full min-w-[650px] text-left text-sm">
          <thead class="border-b border-gray-200 bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
            <tr>
              <th class="px-5 py-4 font-semibold">Payment Date</th>
              <th class="px-5 py-4 font-semibold">Amount</th>
              <th class="px-5 py-4 font-semibold">Method</th>
              <th class="px-5 py-4 font-semibold">Notes</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-100">
            <% @payments.each do |payment| %>
              <tr class="transition hover:bg-blue-50/40">
                <td class="whitespace-nowrap px-5 py-4 text-gray-700">
                  <%= payment.payment_date&.strftime("%d %b %Y") || "—" %>
                </td>

                <td class="whitespace-nowrap px-5 py-4">
                  <span class="font-bold text-green-700">
                    ₹<%= number_with_precision(payment.amount, precision: 2, strip_insignificant_zeros: true) %>
                  </span>
                </td>

                <td class="whitespace-nowrap px-5 py-4">
                  <% if payment.payment_method.present? %>
                    <span class="inline-flex rounded-lg bg-gray-100 px-3 py-1.5 text-xs font-semibold text-gray-700">
                      <%= payment.payment_method.upcase %>
                    </span>
                  <% else %>
                    <span class="text-gray-400">—</span>
                  <% end %>
                </td>

                <td class="px-5 py-4 text-gray-600">
                  <%= payment.notes.presence || "—" %>
                </td>
              </tr>
            <% end %>

            <% if @payments.empty? %>
              <tr>
                <td colspan="4" class="px-5 py-16 text-center">
                  <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-gray-100 text-2xl">💳</div>
                  <p class="mt-4 font-semibold text-gray-900">No payment records yet</p>
                  <p class="mt-1 text-sm text-gray-500">Is student ki abhi koi payment record nahi hai.</p>

                  <% if @library_student.active? %>
                    <%= link_to "＋ Collect Fee",
                        new_library_student_library_payment_path(@library_student),
                        class: "mt-4 inline-flex rounded-xl bg-blue-600 px-4 py-2.5 font-semibold text-white hover:bg-blue-700" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="border-t border-gray-100 px-5 py-4 text-xs text-gray-500">
        Library Management · Payment records
      </div>

    </section>

  </div>
</div>