
<div class="mx-auto max-w-3xl p-4 sm:p-6">
  <div class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-8">
    <h2 class="text-xl font-bold text-gray-900">Student Details</h2>
    <p class="mt-1 text-sm text-gray-500">Library admission ki details bharo.</p>

    <% if @library_student.errors.any? %>
      <div class="mt-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        <p class="font-semibold">Please errors fix karo:</p>
        <ul class="mt-2 list-disc pl-5">
          <% @library_student.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @library_student, class: "mt-6 space-y-5" do |f| %>
      <div>
        <%= f.label :name, "Student ka naam", class: "mb-2 block text-sm font-semibold text-gray-700" %>
        <%= f.text_field :name, required: true, placeholder: "Bachche ka poora naam",
            class: "w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-blue-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :phone, "Mobile number", class: "mb-2 block text-sm font-semibold text-gray-700" %>
        <%= f.telephone_field :phone, placeholder: "Mobile number",
            class: "w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-blue-500 focus:outline-none" %>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :admission_date, "Admission date", class: "mb-2 block text-sm font-semibold text-gray-700" %>
          <%= f.date_field :admission_date, required: true,
              class: "w-full rounded-xl border border-gray-300 px-4 py-3" %>
        </div>

        <div>
          <%= f.label :monthly_fee, "Monthly fee (₹)", class: "mb-2 block text-sm font-semibold text-gray-700" %>
          <%= f.number_field :monthly_fee, min: 1, step: "0.01", required: true,
              class: "w-full rounded-xl border border-gray-300 px-4 py-3" %>
        </div>
      </div>

      <div>
        <%= f.label :notes, "Notes (optional)", class: "mb-2 block text-sm font-semibold text-gray-700" %>
        <%= f.text_area :notes, rows: 3, placeholder: "Koi extra jankari...",
            class: "w-full rounded-xl border border-gray-300 px-4 py-3" %>
      </div>

      <%= f.hidden_field :status, value: "active" if @library_student.new_record? %>

      <div class="flex flex-col gap-3 pt-3 sm:flex-row">
        <%= f.submit(@library_student.new_record? ? "Save Admission" : "Update Student",
            class: "cursor-pointer rounded-xl bg-blue-600 px-6 py-3 font-semibold text-white hover:bg-blue-700") %>

        <%= link_to "Cancel", library_students_path,
            class: "rounded-xl border border-gray-300 px-6 py-3 text-center font-semibold text-gray-700 hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>
</div>
