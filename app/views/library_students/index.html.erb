<div class="min-h-screen bg-gray-50 p-4 sm:p-6">
  <div class="mx-auto max-w-7xl space-y-6">

    <!-- Header -->
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
          Library Management
        </h1>
        <p class="mt-1 text-sm text-gray-500">
          Students, admission aur monthly fee ka hisaab
        </p>
      </div>

      <%= link_to new_library_student_path,
          class: "inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 font-semibold text-white shadow-sm transition hover:bg-blue-700" do %>
        <span class="text-xl leading-none">+</span>
        Add Student
      <% end %>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">

      <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm sm:p-5">
        <div class="flex items-center justify-between gap-2">
          <p class="text-sm font-medium text-gray-500">Active Students</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-xl">👨‍🎓</span>
        </div>
        <p class="mt-3 text-3xl font-bold text-gray-900"><%= @active_count %></p>
        <p class="mt-1 text-xs text-gray-500">Currently enrolled</p>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm sm:p-5">
        <div class="flex items-center justify-between gap-2">
          <p class="text-sm font-medium text-gray-500">Fee Due Soon</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl">⏳</span>
        </div>
        <p class="mt-3 text-3xl font-bold text-amber-600"><%= @due_soon.count %></p>
        <p class="mt-1 text-xs text-gray-500">Payment renewal approaching</p>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm sm:p-5">
        <div class="flex items-center justify-between gap-2">
          <p class="text-sm font-medium text-gray-500">Fee Overdue</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-red-50 text-xl">⚠️</span>
        </div>
        <p class="mt-3 text-3xl font-bold text-red-600"><%= @overdue.count %></p>
        <p class="mt-1 text-xs text-gray-500">Fee renewal required</p>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm sm:p-5">
        <div class="flex items-center justify-between gap-2">
          <p class="text-sm font-medium text-gray-500">Library Left</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gray-100 text-xl">🚪</span>
        </div>
        <p class="mt-3 text-3xl font-bold text-gray-900"><%= @left_count %></p>
        <p class="mt-1 text-xs text-gray-500">Students who have left</p>
      </div>

    </div>

    <!-- Fee Reminders -->
    <% if @due_soon.any? || @overdue.any? %>
      <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
        <div class="flex items-center gap-3 border-b border-gray-100 px-5 py-4 sm:px-6">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl">🔔</span>
          <div>
            <h2 class="font-bold text-gray-900">Fee Reminders</h2>
            <p class="text-sm text-gray-500">Students jinki fee expire hone wali hai ya overdue hai.</p>
          </div>
        </div>

        <div class="space-y-3 p-4 sm:p-6">
          <% @overdue.each do |student| %>
            <div class="flex flex-col justify-between gap-3 rounded-xl border border-red-100 bg-red-50/50 p-4 sm:flex-row sm:items-center">
              <div class="flex items-start gap-3">
                <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-100 text-lg">!</span>
                <div>
                  <p class="font-semibold text-gray-900"><%= student.name %></p>
                  <p class="mt-1 text-sm text-gray-500"><%= student.phone.presence || "No phone number" %></p>
                  <p class="mt-1 text-sm font-medium text-red-600">
                    Fee overdue · Valid till <%= student.fee_valid_till&.strftime("%d %b %Y") || "Not set" %>
                  </p>
                </div>
              </div>
              <%= link_to "View Student →", library_student_path(student),
                  class: "font-semibold text-blue-700 hover:text-blue-800" %>
            </div>
          <% end %>

          <% @due_soon.each do |student| %>
            <div class="flex flex-col justify-between gap-3 rounded-xl border border-amber-100 bg-amber-50/50 p-4 sm:flex-row sm:items-center">
              <div class="flex items-start gap-3">
                <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-100 text-lg">⏳</span>
                <div>
                  <p class="font-semibold text-gray-900"><%= student.name %></p>
                  <p class="mt-1 text-sm text-gray-500"><%= student.phone.presence || "No phone number" %></p>
                  <p class="mt-1 text-sm font-medium text-amber-700">
                    <%= student.days_remaining == 0 ? "Fee aaj khatam hai" : "Fee #{student.days_remaining} din mein khatam" %>
                    · Valid till <%= student.fee_valid_till&.strftime("%d %b %Y") || "Not set" %>
                  </p>
                </div>
              </div>
              <%= link_to "View Student →", library_student_path(student),
                  class: "font-semibold text-blue-700 hover:text-blue-800" %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- Students List -->
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

      <div class="flex flex-col justify-between gap-3 border-b border-gray-100 px-5 py-4 sm:flex-row sm:items-center sm:px-6">
        <div>
          <h2 class="text-lg font-bold text-gray-900">All Students</h2>
          <p class="mt-1 text-sm text-gray-500">Student details aur fee status</p>
        </div>
        <span class="w-fit rounded-lg bg-gray-100 px-3 py-1.5 text-sm font-medium text-gray-600">
          <%= @students.size %> students shown
        </span>
      </div>

      <!-- Search & Filters -->
      <div class="border-b border-gray-100 bg-gray-50/70 p-4 sm:p-5">
        <%= form_with url: library_students_path, method: :get,
            class: "grid grid-cols-1 gap-3 sm:grid-cols-12" do %>

          <div class="sm:col-span-7">
            <%= label_tag :q, "Search students", class: "mb-1.5 block text-sm font-medium text-gray-700" %>
            <%= text_field_tag :q, params[:q],
                placeholder: "Name ya mobile number search karein...",
                class: "w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
          </div>

          <div class="sm:col-span-3">
            <%= label_tag :status, "Student status", class: "mb-1.5 block text-sm font-medium text-gray-700" %>
            <%= select_tag :status,
                options_for_select([["All Students", ""], ["Active", "active"], ["Left", "left"]], params[:status]),
                class: "w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
          </div>

          <div class="flex items-end gap-2 sm:col-span-2">
            <%= submit_tag "Search",
                class: "flex-1 cursor-pointer rounded-xl bg-gray-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-gray-700" %>

            <% if params[:q].present? || params[:status].present? %>
              <%= link_to "Reset", library_students_path,
                  class: "rounded-xl border border-gray-300 bg-white px-3 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-100" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Responsive Table -->
      <div class="overflow-x-auto">
        <table class="w-full min-w-[850px] text-left text-sm">
          <thead class="border-b border-gray-200 bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
            <tr>
              <th class="px-5 py-4 font-semibold">Student</th>
              <th class="px-5 py-4 font-semibold">Admission</th>
              <th class="px-5 py-4 font-semibold">Monthly Fee</th>
              <th class="px-5 py-4 font-semibold">Fee Valid Till</th>
              <th class="px-5 py-4 font-semibold">Status</th>
              <th class="px-5 py-4 text-right font-semibold">Action</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-100">
            <% @students.each do |student| %>
              <tr class="transition hover:bg-blue-50/40">

                <td class="px-5 py-4">
                  <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-50 font-bold text-blue-700">
                      <%= student.name.to_s.first&.upcase || "S" %>
                    </div>
                    <div>
                      <p class="font-semibold text-gray-900"><%= student.name.to_s.titleize %></p>
                      <p class="mt-1 text-xs text-gray-500"><%= student.phone.presence || "No phone" %></p>
                    </div>
                  </div>
                </td>

                <td class="whitespace-nowrap px-5 py-4 text-gray-600">
                  <%= student.admission_date&.strftime("%d %b %Y") || "—" %>
                </td>

                <td class="whitespace-nowrap px-5 py-4">
                  <span class="font-semibold text-gray-900">
                    ₹<%= number_with_precision(student.monthly_fee, precision: 2, strip_insignificant_zeros: true) %>
                  </span>
                  <p class="mt-1 text-xs text-gray-500">Per month</p>
                </td>

                <td class="whitespace-nowrap px-5 py-4 text-gray-600">
                  <%= student.fee_valid_till&.strftime("%d %b %Y") || "Payment pending" %>
                </td>

                <td class="whitespace-nowrap px-5 py-4">
                  <% if student.left? %>
                    <span class="inline-flex rounded-full bg-gray-100 px-3 py-1.5 text-xs font-semibold text-gray-700">
                      Left
                    </span>
                  <% elsif student.fee_warning.present? %>
                    <span class="inline-flex rounded-full bg-amber-100 px-3 py-1.5 text-xs font-semibold text-amber-800">
                      <%= student.fee_warning %>
                    </span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-green-100 px-3 py-1.5 text-xs font-semibold text-green-800">
                      Active
                    </span>
                  <% end %>
                </td>

                <td class="whitespace-nowrap px-5 py-4 text-right">
                  <%= link_to library_student_path(student),
                      class: "inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white px-4 py-2 font-semibold text-blue-700 transition hover:border-blue-200 hover:bg-blue-50" do %>
                    Open <span class="ml-2">→</span>
                  <% end %>
                </td>

              </tr>
            <% end %>

            <% if @students.empty? %>
              <tr>
                <td colspan="6" class="px-5 py-16 text-center">
                  <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-gray-100 text-2xl">🔎</div>
                  <p class="mt-4 font-semibold text-gray-900">Koi student nahi mila</p>
                  <p class="mt-1 text-sm text-gray-500">Search badal kar dekhein ya naya student add karein.</p>
                  <%= link_to "＋ Add Student", new_library_student_path,
                      class: "mt-4 inline-flex rounded-xl bg-blue-600 px-4 py-2.5 font-semibold text-white hover:bg-blue-700" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="border-t border-gray-100 px-5 py-4 text-xs text-gray-500">
        Library Management · Student records and fee tracking
      </div>

    </section>

  </div>
</div>