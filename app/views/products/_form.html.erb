<%= form_with model: @product, class: "space-y-6" do |f| %>

  <!-- Validation Errors -->
  <% if @product.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4">
      <h3 class="font-semibold text-red-800">
        Please fix these errors:
      </h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
        <% @product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Main Product Card -->
  <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

    <!-- Card Header -->
    <div class="flex items-center gap-4 border-b border-gray-100 bg-gray-50 px-5 py-5 sm:px-7">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-600">
        <svg xmlns="http://www.w3.org/2000/svg"
             class="h-6 w-6" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
        </svg>
      </div>

      <div>
        <h2 class="text-lg font-bold text-gray-900">
          Product Information
        </h2>
        <p class="mt-1 text-sm text-gray-500">
          Add product details and set your pricing.
        </p>
      </div>
    </div>

    <!-- Form Fields -->
    <div class="space-y-6 p-5 sm:p-7">

      <!-- Product Name -->
      <div>
        <%= f.label :name, class: "mb-2 block text-sm font-semibold text-gray-700" do %>
          Product Name <span class="text-red-500">*</span>
        <% end %>

        <%= f.text_field :name,
            required: true,
            autofocus: true,
            placeholder: "e.g. Sugar, Rice, Cooking Oil",
            class: "w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>

        <p class="mt-2 text-xs text-gray-500">
          Enter a recognizable name for quick billing and searching.
        </p>
      </div>

      <!-- Pricing Section -->
      <div>
        <div class="mb-3">
          <h3 class="text-sm font-bold text-gray-800">
            Pricing Details
          </h3>
          <p class="mt-1 text-xs text-gray-500">
            Enter the purchase cost and customer selling price.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

          <!-- Purchase Price -->
          <div class="rounded-xl border border-gray-200 p-4">
            <%= f.label :purchase_price, "Purchase Price (₹)",
                class: "mb-2 block text-sm font-semibold text-gray-700" %>

            <div class="flex overflow-hidden rounded-xl border border-gray-300 bg-gray-50 transition focus-within:border-blue-500 focus-within:ring-4 focus-within:ring-blue-100">
              <span class="flex items-center border-r border-gray-200 px-4 font-semibold text-gray-500">
                ₹
              </span>

              <%= f.number_field :purchase_price,
                  min: 0,
                  step: "0.01",
                  required: true,
                  placeholder: "0.00",
                  class: "w-full min-w-0 bg-transparent px-3 py-3 text-sm text-gray-900 outline-none" %>
            </div>

            <p class="mt-2 text-xs text-gray-500">
              Cost paid to purchase the product.
            </p>
          </div>

          <!-- Selling Price -->
          <div class="rounded-xl border border-blue-100 bg-blue-50/40 p-4">
            <%= f.label :selling_price, "Selling Price (₹)",
                class: "mb-2 block text-sm font-semibold text-gray-700" %>

            <div class="flex overflow-hidden rounded-xl border border-gray-300 bg-white transition focus-within:border-blue-500 focus-within:ring-4 focus-within:ring-blue-100">
              <span class="flex items-center border-r border-gray-200 px-4 font-semibold text-gray-500">
                ₹
              </span>

              <%= f.number_field :selling_price,
                  min: 0,
                  step: "0.01",
                  required: true,
                  placeholder: "0.00",
                  class: "w-full min-w-0 bg-transparent px-3 py-3 text-sm text-gray-900 outline-none" %>
            </div>

            <p class="mt-2 text-xs text-gray-500">
              Price charged to the customer.
            </p>
          </div>

        </div>
      </div>

      <!-- Unit -->
      <div class="border-t border-gray-100 pt-5">
        <%= f.label :unit, "Measurement Unit",
            class: "mb-2 block text-sm font-semibold text-gray-700" %>

        <%= f.select :unit,
            options_for_select(
              [
                ["Kilograms (kg)", "kg"],
                ["Pieces (pcs)", "pcs"],
                ["Grams (g)", "g"],
                ["Litres (ltr)", "ltr"],
                ["Millilitres (ml)", "ml"],
                ["Packets (pkt)", "pkt"],
                ["Boxes (box)", "box"],
                ["Dozens (dozen)", "dozen"]
              ],
              @product.unit.presence || "kg"
            ),
            {},
            class: "w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100 sm:max-w-md" %>

        <p class="mt-2 text-xs text-gray-500">
          Choose the unit used to sell this product.
        </p>
      </div>

    </div>
  </div>

  <!-- Action Buttons -->
  <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

    <%= link_to products_path,
        class: "inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-6 py-3 text-sm font-semibold text-gray-700 transition hover:bg-gray-50" do %>
      Cancel
    <% end %>

    <%= f.submit(@product.persisted? ? "Update Product" : "Save Product",
        class: "inline-flex cursor-pointer items-center justify-center rounded-xl bg-blue-600 px-7 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-200") %>

  </div>

<% end %>