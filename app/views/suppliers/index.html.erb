<div class="min-h-screen bg-gray-50 p-4 sm:p-6">
  <div class="mx-auto max-w-7xl">

    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">Supplier Khata</h1>
        <p class="mt-1 text-sm text-gray-500">Dealers, maal aur payments ka hisaab</p>
      </div>

      <%= link_to "＋ Add Supplier", new_supplier_path,
          class: "inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white hover:bg-blue-700" %>
    </div>

    <% if notice.present? %>
      <div class="mb-4 rounded-xl border border-green-200 bg-green-50 p-3 text-sm text-green-700">
        <%= notice %>
      </div>
    <% end %>

    <div class="mb-5 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-gray-200 bg-white p-5">
        <p class="text-sm text-gray-500">Total Suppliers</p>
        <p class="mt-2 text-3xl font-bold text-gray-900"><%= @suppliers.count %></p>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-5">
        <p class="text-sm text-gray-500">Total Baaki Dena Hai</p>
        <p class="mt-2 text-3xl font-bold text-red-600">
          ₹<%= number_with_precision(@suppliers.sum(&:current_balance), precision: 2, delimiter: ",") %>
        </p>
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white">
      <div class="border-b border-gray-100 p-4">
        <h2 class="font-semibold text-gray-900">All Suppliers</h2>
      </div>

      <% if @suppliers.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[650px] text-left text-sm">
            <thead class="bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-5 py-4">Shop / Dealer</th>
                <th class="px-5 py-4">Phone</th>
                <th class="px-5 py-4 text-right">Udhaar</th>
                <th class="px-5 py-4 text-right">Jama</th>
                <th class="px-5 py-4 text-right">Baaki</th>
                <th class="px-5 py-4 text-right">Action</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-gray-100">
              <% @suppliers.each do |supplier| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-5 py-4">
                    <p class="font-semibold text-gray-900"><%= supplier.shop_name.to_s.titleize %></p>
                    <p class="mt-1 text-xs text-gray-500"><%= supplier.dealer_name.presence || "" %></p>
                  </td>
                  <td class="px-5 py-4 text-gray-600"><%= supplier.phone.presence || "—" %></td>
                  <td class="px-5 py-4 text-right"><%= number_to_currency(supplier.total_udhaar, unit: "₹", precision: 2, delimiter: ",") %></td>
                  <td class="px-5 py-4 text-right text-green-700"><%= number_to_currency(supplier.total_jama, unit: "₹", precision: 2, delimiter: ",") %></td>
                  <td class="px-5 py-4 text-right font-bold text-red-600"><%= number_to_currency(supplier.current_balance, unit: "₹", precision: 2, delimiter: ",") %></td>
                  <td class="px-5 py-4 text-right">
                    <%= link_to "Khata Khole →", supplier_path(supplier),
                        class: "font-semibold text-blue-600 hover:text-blue-800" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-10 text-center">
          <p class="font-semibold text-gray-800">Abhi koi supplier nahi hai</p>
          <p class="mt-1 text-sm text-gray-500">Apna pehla supplier add karo.</p>
          <%= link_to "Add Supplier", new_supplier_path,
              class: "mt-4 inline-block rounded-xl bg-blue-600 px-5 py-3 font-semibold text-white" %>
        </div>
      <% end %>
    </div>

  </div>
</div>