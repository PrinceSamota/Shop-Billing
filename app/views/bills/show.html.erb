@media print {
  /* Browser aur application ke default gaps hatao */
  @page {
    size: 80mm auto;
    margin: 0 !important;
  }

  html,
  body {
    width: 80mm !important;
    min-width: 0 !important;
    height: auto !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: #fff !important;
  }

  /* Layout sidebar aur main content ki padding hatao */
  body > header,
  body > aside,
  #mobile-sidebar {
    display: none !important;
  }

  main,
  main > div {
    display: block !important;
    width: 80mm !important;
    max-width: none !important;
    min-width: 0 !important;
    height: auto !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    transform: none !important;
  }

  /* Sirf receipt print ho */
  body * {
    visibility: hidden !important;
  }

  #bill_receipt,
  #bill_receipt * {
    visibility: visible !important;
  }

  #bill_receipt {
    position: relative !important;
    left: 0 !important;
    top: 0 !important;
    display: block !important;
    width: 72mm !important;
    max-width: 72mm !important;
    min-width: 0 !important;
    height: auto !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    overflow: visible !important;
    box-sizing: border-box !important;
    break-before: auto !important;
    break-after: auto !important;
    page-break-before: auto !important;
    page-break-after: auto !important;
  }

  #bill_receipt .receipt-header,
  #bill_receipt .customer-section,
  #bill_receipt .items-section,
  #bill_receipt .border-t.border-dashed.border-gray-300,
  #bill_receipt > div:last-child {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  /* Print ke time screen-only elements hide */
  .print\:hidden {
    display: none !important;
  }
}

</style>

<script>
  (() => {
    function initBillShow() {
      const printButton = document.getElementById("print_bill_btn");
      const smsButton = document.getElementById("send_bill_sms_btn");

      if (printButton && !printButton.dataset.bound) {
        printButton.dataset.bound = "true";

        printButton.addEventListener("click", () => {
          window.print();
        });
      }

      if (smsButton && !smsButton.dataset.bound) {
        smsButton.dataset.bound = "true";

        smsButton.addEventListener("click", () => {
          alert("SMS abhi configure nahi hua hai. Real SMS bhejne ke liye SMS provider aur Rails backend setup karna hoga.");
        });
      }
    }

    document.addEventListener("DOMContentLoaded", initBillShow);
    document.addEventListener("turbo:load", initBillShow);
  })();
</script>
