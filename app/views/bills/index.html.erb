 <div class="min-h-screen bg-gray-50 p-4 sm:p-6 lg:p-8">
  <div class="mx-auto max-w-7xl">
    <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-gray-900">Bills</h1>
        <p class="mt-1 text-sm text-gray-500">Manage your shop bills, payments and customer dues.</p>
      </div>
      <%= link_to new_bill_path, class: "inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700" do %>
        <span class="text-lg leading-none">+</span>
        New Bill
      <% end %>
    </div>

    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-gray-500">Total Bills</p>
        <p class="mt-2 text-2xl font-bold text-gray-900"><%= @bills.size %></p>
      </div>
      <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-gray-500">Finalized Bills</p>
        <p class="mt-2 text-2xl font-bold text-gray-900"><%= @bills.count { |bill| bill.status == "finalized" } %></p>
      </div>
      <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-gray-500">Pending Payments</p>
        <p class="mt-2 text-2xl font-bold text-orange-600"><%= @bills.count { |bill| %w[unpaid partial].include?(bill.payment_status) } %></p>
      </div>
    </div>

    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 p-4 sm:p-5">
        <%= form_with url: bills_path, method: :get, local: true, class: "flex flex-col gap-3 sm:flex-row" do |form| %>
          <div class="relative flex-1">
            <%= form.text_field :search, value: params[:search], placeholder: "Search bill number or customer...", class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
          </div>
          <%= form.submit "Search", class: "cursor-pointer rounded-lg border border-gray-300 bg-white px-5 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
          <% if params[:search].present? %>
            <%= link_to "Clear", bills_path, class: "rounded-lg px-4 py-3 text-center text-sm font-medium text-gray-600 hover:bg-gray-100" %>
          <% end %>
        <% end %>
      </div>

      <% if @bills.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Bill Number</th>
                <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Customer</th>
                <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Date</th>
                <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Amount</th>
                <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Bill Status</th>
                <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Payment</th>
                <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              <% @bills.each do |bill| %>
                <tr class="transition hover:bg-gray-50">
                  <td class="whitespace-nowrap px-5 py-4">
                    <span class="font-semibold text-gray-900"><%= bill.bill_number.presence || "Draft ##{bill.id}" %></span>
                  </td>
                  <td class="whitespace-nowrap px-5 py-4 text-sm text-gray-700">
                    <% customer_name = bill.customer&.name.to_s.titleize.presence %>
                    <% walk_in_name = bill.walk_in_name.to_s.titleize.presence %>

                    <p class="mt-1 break-words font-bold text-gray-900">
                      <%= customer_name || walk_in_name || "Walk-in Customer" %>
                    </p>
                  </td>
                  <td class="whitespace-nowrap px-5 py-4 text-sm text-gray-500">
                    <%= bill.created_at.strftime("%d %b %Y") %>
                  </td>
                  <td class="whitespace-nowrap px-5 py-4 text-right text-sm font-semibold text-gray-900">
                    <%= number_to_currency(bill.total_amount || 0, unit: "₹", precision: 2, delimiter: ",") %>
                  </td>
                  <td class="whitespace-nowrap px-5 py-4">
                    <% if bill.status == "finalized" %>
                      <span class="inline-flex rounded-full bg-green-100 px-2.5 py-1 text-xs font-medium text-green-700">Finalized</span>
                    <% else %>
                      <span class="inline-flex rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700"><%= bill.status.to_s.humanize.presence || "Draft" %></span>
                    <% end %>
                  </td>
                  <td class="whitespace-nowrap px-5 py-4">
                    <% case bill.payment_status %>
                    <% when "paid" %>
                      <span class="inline-flex rounded-full bg-green-100 px-2.5 py-1 text-xs font-medium text-green-700">Paid</span>
                    <% when "partial" %>
                      <span class="inline-flex rounded-full bg-yellow-100 px-2.5 py-1 text-xs font-medium text-yellow-800">Partial</span>
                    <% else %>
                      <span class="inline-flex rounded-full bg-red-100 px-2.5 py-1 text-xs font-medium text-red-700">Unpaid</span>
                    <% end %>
                  </td>
                  <td class="whitespace-nowrap px-5 py-4 text-right">
                    <%= link_to "View", bill_path(bill), class: "font-semibold text-blue-600 hover:text-blue-800" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-6 py-16 text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-blue-50 text-blue-600">
            <span class="text-2xl">₹</span>
          </div>
          <h3 class="mt-4 text-base font-semibold text-gray-900">No bills yet</h3>
          <p class="mt-1 text-sm text-gray-500">Create your first bill to get started.</p>
          <%= link_to "Create New Bill", new_bill_path, class: "mt-5 inline-flex rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>