<div class="mx-auto max-w-7xl space-y-6 p-4 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
    <%= link_to "← Bahi-Khata",
        customer_path(@customer),
        class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium transition hover:bg-gray-50" %>

    <div class="text-right">
        <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">
        Customer Bills
        </h1>
        <p class="mt-1 text-sm text-gray-500">
        <%= @customer.name.to_s.titleize %> ·
        Customer Code: <%= @customer.customer_code %>
        </p>
    </div>
    </div>

  <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 p-5">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">
        All Bills
        </h2>
    </div>

    <div class="text-right">
        <p class="text-sm text-gray-500">Total Bills</p>
        <p class="mt-1 text-2xl font-bold text-gray-900">
        <%= @bills.size %>
        </p>
    </div>
    </div>


    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="whitespace-nowrap px-4 py-3 text-left font-semibold text-gray-600">Date</th>
            <th class="whitespace-nowrap px-4 py-3 text-left font-semibold text-gray-600">Bill Number</th>
            <th class="px-4 py-3 text-left font-semibold text-gray-600">Items</th>
            <th class="whitespace-nowrap px-4 py-3 text-right font-semibold text-gray-600">Bill Amount</th>
            <th class="whitespace-nowrap px-4 py-3 text-right font-semibold text-gray-600">Bill Payment</th>
            <th class="whitespace-nowrap px-4 py-3 text-right font-semibold text-gray-600">Bill Balance</th>
            <th class="px-4 py-3 text-center font-semibold text-gray-600">Action</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-gray-100">
          <% if @bills.any? %>
            <% @bills.each do |bill| %>
              <tr class="hover:bg-gray-50">
                <td class="whitespace-nowrap px-4 py-3 text-gray-600">
                  <%= (bill.finalized_at || bill.created_at)&.strftime("%d-%m-%Y") %>
                </td>

                <td class="whitespace-nowrap px-4 py-3 font-medium">
                  <%= link_to bill.bill_number,
                      bill_path(bill),
                      class: "text-blue-600 hover:underline" %>
                </td>

                <td class="min-w-48 px-4 py-3 text-gray-600">
                  <% bill.bill_items.each do |item| %>
                    <p>
                      <%= item.product_name %>
                      × <%= item.quantity %>
                      <%= item.unit %>
                    </p>
                  <% end %>
                </td>

                <td class="whitespace-nowrap px-4 py-3 text-right font-semibold text-gray-900">
                  <%= number_to_currency(bill.total_amount, unit: "₹", precision: 2) %>
                </td>

                <td class="whitespace-nowrap px-4 py-3 text-right text-green-600">
                  <%= number_to_currency(bill.paid_amount, unit: "₹", precision: 2) %>
                </td>

                <td class="whitespace-nowrap px-4 py-3 text-right text-red-600">
                  <%= number_to_currency(
                    [bill.total_amount.to_d - bill.paid_amount.to_d, 0.to_d].max,
                    unit: "₹",
                    precision: 2
                  ) %>
                </td>

                <td class="whitespace-nowrap px-4 py-3 text-center">
                  <%= link_to "View Bill",
                      bill_path(bill),
                      class: "rounded-lg bg-blue-600 px-3 py-2 text-xs font-semibold text-white hover:bg-blue-700" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="px-4 py-10 text-center text-gray-500">
                Is customer ka abhi koi finalized bill nahi hai.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>
