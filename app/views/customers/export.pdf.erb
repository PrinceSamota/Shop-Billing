
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body {
      font-family: Arial, sans-serif;
      font-size: 10px;
      color: #222;
    }

    h1, .subtitle {
      text-align: center;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }

    th, td {
      border: 1px solid #ccc;
      padding: 7px;
      text-align: left;
      overflow-wrap: break-word;
    }

    th {
      background: #f3f4f6;
    }

    .amount {
      text-align: right;
      white-space: nowrap;
    }
  </style>
</head>
<body>
  <h1>BALAJI TRADERS</h1>
  <p class="subtitle">Customer Directory & Outstanding Balance</p>
  <p class="subtitle">
    Generated on: <%= Date.current.strftime("%d-%m-%Y") %>
  </p>

  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>ID</th>
        <th>Customer Code</th>
        <th>Mobile</th>
        <th>Email</th>
        <th>Address</th>
        <th>Outstanding (₹)</th>
      </tr>
    </thead>

    <tbody>
      <% @customers.each do |customer| %>
        <tr>
          <td><%= customer.name %></td>
          <td><%= customer.id %></td>
          <td><%= customer.customer_code %></td>
          <td><%= customer.phone %></td>
          <td><%= customer.email if customer.respond_to?(:email) %></td>
          <td><%= customer.address %></td>
          <td class="amount">
            <%= number_to_currency(@customer_balances[customer.id], unit: "₹", precision: 2) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</body>
</html>
