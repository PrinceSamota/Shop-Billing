<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Dukaan Billing" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-800">

    <!-- Mobile Header -->
    <header class="sticky top-0 z-40 flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3 md:hidden">
      <a href="/" class="text-xl font-bold text-blue-700">
        Dukaan ERP
      </a>

      <button
        type="button"
        onclick="document.getElementById('mobile-sidebar').classList.toggle('hidden')"
        class="rounded-lg border border-gray-200 px-3 py-2 text-sm font-semibold hover:bg-gray-50">
        ☰ Menu
      </button>
    </header>

    <!-- Mobile Sidebar -->
    <aside id="mobile-sidebar"
      class="fixed inset-y-0 left-0 z-50 hidden w-72 max-w-[85vw] overflow-y-auto border-r border-gray-200 bg-white p-5 shadow-xl md:hidden">

      <div class="mb-8 flex items-center justify-between">
        <h1 class="text-xl font-bold text-blue-700">Dukaan ERP</h1>

        <button
          type="button"
          onclick="document.getElementById('mobile-sidebar').classList.add('hidden')"
          class="rounded-lg px-3 py-2 text-gray-500 hover:bg-gray-100">
          ✕
        </button>
      </div>

      <nav class="space-y-2">
        <a href="/" class="block rounded-xl px-4 py-3 font-medium hover:bg-blue-50 hover:text-blue-700">Dashboard</a>
        <a href="/bills" class="block rounded-xl px-4 py-3 font-medium hover:bg-blue-50 hover:text-blue-700">New Bill</a>
        <a href="/products" class="block rounded-xl px-4 py-3 font-medium hover:bg-blue-50 hover:text-blue-700">Products & Stock</a>
        <a href="/customers" class="block rounded-xl px-4 py-3 font-medium hover:bg-blue-50 hover:text-blue-700">Customers</a>
        <a href="/payments" class="block rounded-xl px-4 py-3 font-medium hover:bg-blue-50 hover:text-blue-700">Payments & Udhaar</a>
        <a href="/reports" class="block rounded-xl px-4 py-3 font-medium hover:bg-blue-50 hover:text-blue-700">Daily / Monthly Reports</a>
        <a href="/expenses" class="block rounded-xl px-4 py-3 font-medium hover:bg-blue-50 hover:text-blue-700">Expenses</a>
        <a href="/settings" class="block rounded-xl px-4 py-3 font-medium hover:bg-blue-50 hover:text-blue-700">Settings</a>
      </nav>
    </aside>

    <!-- Desktop Sidebar -->
    <aside class="fixed inset-y-0 left-0 z-30 hidden w-64 overflow-y-auto border-r border-gray-200 bg-white p-5 md:block">

      <a href="/" class="mb-8 block text-2xl font-bold tracking-tight text-blue-700">
        BALAJI TRADERS
        <span class="mt-1 block text-xs font-normal text-gray-400">
          Billing & Inventory
        </span>
      </a>

      <nav class="space-y-2">
        <a href="/" class="block rounded-xl px-4 py-3 font-medium transition hover:bg-blue-50 hover:text-blue-700">
          🏠 Dashboard
        </a>

        <a href="/bills" class="block rounded-xl px-4 py-3 font-medium transition hover:bg-blue-50 hover:text-blue-700">
          🧾 New Bill
        </a>

        <a href="/products" class="block rounded-xl px-4 py-3 font-medium transition hover:bg-blue-50 hover:text-blue-700">
          📦 Products
        </a>

        <a href="/customers" class="block rounded-xl px-4 py-3 font-medium transition hover:bg-blue-50 hover:text-blue-700">
          👥 Customers
        </a>

      <!--  <a href="/payments" class="block rounded-xl px-4 py-3 font-medium transition hover:bg-blue-50 hover:text-blue-700">
          💰 Payments & Udhaar
        </a>

        <a href="/reports" class="block rounded-xl px-4 py-3 font-medium transition hover:bg-blue-50 hover:text-blue-700">
          📊 Daily / Monthly Reports
        </a>

        <a href="/expenses" class="block rounded-xl px-4 py-3 font-medium transition hover:bg-blue-50 hover:text-blue-700">
          💳 Expenses
        </a>

        <a href="/settings" class="block rounded-xl px-4 py-3 font-medium transition hover:bg-blue-50 hover:text-blue-700">
          ⚙️ Settings
        </a> -->
      </nav>


    </aside>

    <!-- Main Content: Sidebar ke liye left space -->
    <main class="min-h-screen min-w-0 md:ml-64">
      <div class="mx-auto w-full max-w-[1600px]">
        <%= yield %>
      </div>
    </main>

  </body>
</html>