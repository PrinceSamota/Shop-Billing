
<div class="min-h-screen bg-gray-50 px-3 py-6 text-gray-800 sm:px-6">
  <main class="mx-auto max-w-7xl">

    <!-- Header -->
    <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">
          Dashboard
        </h1>
        <p class="mt-1 text-sm text-gray-500">
          Welcome to your shop management system.
        </p>
      </div>

      <%= link_to new_bill_path,
          class: "inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-700" do %>
        <span class="text-lg">+</span>
        New Bill
      <% end %>
    </header>

   <!-- Summary Cards -->
<section class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-5">

  <!-- Today's Sales -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-gray-500">Today's Sales</p>
      <span class="rounded-lg bg-blue-50 p-2 text-blue-600">₹</span>
    </div>
    <p class="mt-4 text-2xl font-bold text-gray-900">
      <%= number_to_currency(@today_sales || 0, unit: "₹", precision: 2) %>
    </p>
    <p class="mt-2 text-xs text-gray-500">Today's finalized bills only</p>
  </div>

  <!-- Today's Bills -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-gray-500">Today's Bills</p>
      <span class="rounded-lg bg-violet-50 p-2 text-violet-600">▤</span>
    </div>
    <p class="mt-4 text-2xl font-bold text-gray-900">
      <%= @today_bills_count || 0 %>
    </p>
    <p class="mt-2 text-xs text-gray-500">Bills finalized today</p>
  </div>

  <!-- Today's Money Received -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-gray-500">Today's Money Received</p>
      <span class="rounded-lg bg-green-50 p-2 text-green-600">₹</span>
    </div>

    <p class="mt-4 text-2xl font-bold text-green-700">
      <%= number_to_currency(@today_money_received || 0, unit: "₹", precision: 2) %>
    </p>

    <p class="mt-2 text-xs text-gray-500">
      Payments received today
    </p>
  </div>

  <!-- Today's Udhaar -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-gray-500">Today's Udhaar</p>
      <span class="rounded-lg bg-amber-50 p-2 text-amber-600">₹</span>
    </div>
    <p class="mt-4 text-2xl font-bold text-gray-900">
      <%= number_to_currency(@today_udhaar || 0, unit: "₹", precision: 2) %>
    </p>
    <p class="mt-2 text-xs text-gray-500">Today's unpaid bill amounts</p>
  </div>

  <!-- Profit: Hidden Until Clicked -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between gap-2">
      <p class="text-sm font-medium text-gray-500">Estimated Profit</p>
      <span class="rounded-lg bg-green-50 p-2 text-green-600">↗</span>
    </div>

    <div class="mt-4">
      <p id="profit-value"
         class="text-2xl font-bold text-gray-900 hidden">
        <%= number_to_currency(@today_profit || 0, unit: "₹", precision: 2) %>
      </p>

      <p id="profit-hidden" class="text-2xl font-bold tracking-widest text-gray-400">
        ••••••
      </p>
    </div>

    <button type="button"
            id="toggle-profit"
            aria-expanded="false"
            class="mt-3 inline-flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">
      <span id="profit-button-text">Show Profit</span>
    </button>

    <p class="mt-2 text-xs text-gray-500">Today's estimated profit</p>
  </div>

</section>

    <!-- Quick Actions -->
    <section class="mt-8 rounded-xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="mb-5">
        <h2 class="text-lg font-bold text-gray-900">Quick Actions</h2>
        <p class="mt-1 text-sm text-gray-500">
          Quickly create new records or manage your shop.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">

        <%= link_to new_bill_path,
            class: "flex items-center gap-3 rounded-xl border border-blue-200 bg-blue-50 p-4 transition hover:bg-blue-100" do %>
          <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-blue-600 text-xl text-white">+</span>
          <span>
            <span class="block font-semibold text-gray-900">New Bill</span>
            <span class="mt-1 block text-xs text-gray-500">Create a customer bill</span>
          </span>
        <% end %>

        <%= link_to new_customer_path,
            class: "flex items-center gap-3 rounded-xl border border-gray-200 p-4 transition hover:bg-gray-50" do %>
          <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-green-100 text-green-700">♙</span>
          <span>
            <span class="block font-semibold text-gray-900">New Customer</span>
            <span class="mt-1 block text-xs text-gray-500">Add customer details</span>
          </span>
        <% end %>

        <%= link_to new_product_path,
            class: "flex items-center gap-3 rounded-xl border border-gray-200 p-4 transition hover:bg-gray-50" do %>
          <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-violet-100 text-violet-700">▦</span>
          <span>
            <span class="block font-semibold text-gray-900">New Product</span>
            <span class="mt-1 block text-xs text-gray-500">Add item and its price</span>
          </span>
        <% end %>

        <%= link_to customers_path,
            class: "flex items-center gap-3 rounded-xl border border-gray-200 p-4 transition hover:bg-gray-50" do %>
          <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-amber-100 text-amber-700">☷</span>
          <span>
            <span class="block font-semibold text-gray-900">All Customers</span>
            <span class="mt-1 block text-xs text-gray-500">View customers and balances</span>
          </span>
        <% end %>

        <%= link_to products_path,
            class: "flex items-center gap-3 rounded-xl border border-gray-200 p-4 transition hover:bg-gray-50" do %>
          <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-gray-100 text-gray-700">▤</span>
          <span>
            <span class="block font-semibold text-gray-900">All Products</span>
            <span class="mt-1 block text-xs text-gray-500">View products and rates</span>
          </span>
        <% end %>

        <%= link_to bills_path,
            class: "flex items-center gap-3 rounded-xl border border-gray-200 p-4 transition hover:bg-gray-50" do %>
          <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-indigo-100 text-indigo-700">▧</span>
          <span>
            <span class="block font-semibold text-gray-900">All Bills</span>
            <span class="mt-1 block text-xs text-gray-500">View bill records</span>
          </span>
        <% end %>

      </div>
    </section>

    <!-- Recent Bills -->
    <section class="mt-8 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 p-5 sm:px-6">
        <div>
          <h2 class="text-lg font-bold text-gray-900">Recent Bills</h2>
          <p class="mt-1 text-sm text-gray-500">Your latest finalized bills.</p>
        </div>

        <%= link_to "View All Bills", bills_path,
            class: "text-sm font-semibold text-blue-600 hover:text-blue-800" %>
      </div>

      <% if @recent_bills.present? %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-5 py-3 font-semibold">Bill Number</th>
                <th class="px-5 py-3 font-semibold">Customer</th>
                <th class="px-5 py-3 font-semibold">Date</th>
                <th class="px-5 py-3 text-right font-semibold">Amount</th>
                <th class="px-5 py-3 text-center font-semibold">Payment</th>
                <th class="px-5 py-3 text-right font-semibold">Action</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-gray-100">
              <% @recent_bills.each do |bill| %>
                <tr class="transition hover:bg-gray-50">
                  <td class="whitespace-nowrap px-5 py-4 font-semibold text-blue-600">
                    <%= link_to bill.bill_number, bill_path(bill), class: "hover:underline" %>
                  </td>

                  <td class="whitespace-nowrap px-5 py-4 text-gray-700">
                    <%= bill.customer&.name&.titleize || "Walk-in Customer" %>
                  </td>

                  <td class="whitespace-nowrap px-5 py-4 text-gray-500">
                    <%= (bill.finalized_at || bill.created_at)&.strftime("%d %b %Y, %I:%M %p") %>
                  </td>

                  <td class="whitespace-nowrap px-5 py-4 text-right font-semibold text-gray-900">
                    <%= number_to_currency(bill.total_amount || 0, unit: "₹", precision: 2) %>
                  </td>

                  <td class="whitespace-nowrap px-5 py-4 text-center">
                    <% if bill.payment_status.to_s == "paid" %>
                      <span class="rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700">Paid</span>
                    <% elsif bill.payment_status.to_s == "partial" %>
                      <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-700">Partial</span>
                    <% else %>
                      <span class="rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700">Credit</span>
                    <% end %>
                  </td>

                  <td class="whitespace-nowrap px-5 py-4 text-right">
                    <%= link_to "View", bill_path(bill),
                        class: "font-semibold text-blue-600 hover:underline" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-6 py-12 text-center">
          <p class="font-medium text-gray-700">No finalized bills yet</p>
          <p class="mt-1 text-sm text-gray-500">Create your first bill to see it here.</p>
          <%= link_to "Create New Bill", new_bill_path,
              class: "mt-4 inline-flex rounded-lg bg-blue-600 px-4 py-2.5 font-semibold text-white hover:bg-blue-700" %>
        </div>
      <% end %>
    </section>

  </main>
</div>
<script>
  document.addEventListener("turbo:load", setupProfitToggle);
  document.addEventListener("DOMContentLoaded", setupProfitToggle);

  function setupProfitToggle() {
    const button = document.getElementById("toggle-profit");
    const value = document.getElementById("profit-value");
    const hidden = document.getElementById("profit-hidden");
    const buttonText = document.getElementById("profit-button-text");

    if (!button || button.dataset.initialized === "true") return;
    button.dataset.initialized = "true";

    button.addEventListener("click", function () {
      const isVisible = !value.classList.contains("hidden");

      value.classList.toggle("hidden", isVisible);
      hidden.classList.toggle("hidden", !isVisible);
      buttonText.textContent = isVisible ? "Show Profit" : "Hide Profit";
      button.setAttribute("aria-expanded", String(!isVisible));
    });
  }
</script>